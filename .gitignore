# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# Firebase service-account files should never be committed.
firebase-service-account*.json
service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Keep only the root README as tracked Markdown documentation
*.md
!/README.md

# Local workflow and project-context files
Workflows/
