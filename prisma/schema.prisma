generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationRoleCode {
  admin
  hr
  employee
  payroll
  accounting
}

enum UserStatus {
  active
  inactive
  disabled
}

enum EmployeeEmploymentStatus {
  active
  inactive
}

enum EmployeeSourceSystem {
  HRPS
}

enum HrpsImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  ROLLING_BACK
  ROLLED_BACK
  ROLLBACK_FAILED
}

enum HrpsImportRowStatus {
  PENDING
  ROLLED_BACK
  BLOCKED
}

enum BundyImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  ROLLING_BACK
  ROLLED_BACK
  ROLLBACK_FAILED
}

enum BundyEventType {
  IN
  OUT
}

enum BundyMatchStatus {
  MATCHED
  UNMATCHED
  EMPLOYEE_INACTIVE
}

enum BundyValidationStatus {
  VALID
  INVALID
}

enum BundyDuplicateStatus {
  UNIQUE
  DUPLICATE_SCAN
}

enum AttendanceSource {
  QR
  BUNDY
}

enum AttendanceStatus {
  present
  completed
}

enum UnifiedAttendanceTechnicalState {
  NO_EVENTS
  IN_PROGRESS
  COMPLETE
  MISSING_IN
  MISSING_OUT
  NEEDS_REVIEW
}

enum UnifiedAttendanceBusinessStatus {
  UNCLASSIFIED
  PRESENT
  LATE
  ABSENT
}

enum UnifiedAttendanceProcessingRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum UnifiedAttendanceProcessingItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UnifiedAttendanceProcessingRunType {
  INITIAL
  REPROCESS
}

enum UnifiedAttendanceProcessingOperation {
  CREATED
  UPDATED
  UNCHANGED
}

enum HrVerificationStatus {
  pending
  verified
}

enum PayrollReadinessStatus {
  ready
  blocked
}

enum AttendanceCorrectionStatus {
  pending
  approved
  rejected
}

enum AttendanceCorrectionIssueType {
  MissingTimeIn              @map("Missing Time-In")
  MissingTimeOut             @map("Missing Time-Out")
  IncorrectTimeIn            @map("Incorrect Time-In")
  IncorrectTimeOut           @map("Incorrect Time-Out")
  TimeInAndTimeOutCorrection @map("Time In and Time Out Correction")
}

enum PayrollBatchStatus {
  Draft        @map("Draft")
  Ready        @map("Ready")
  Submitted    @map("Submitted")
  Acknowledged @map("Acknowledged")
  Blocked      @map("Blocked")
  Failed       @map("Failed")
}

enum PayrollTransferStatus {
  preparing
  submitting
  submitted
  failed
}

enum PayrollAcknowledgementStatus {
  pending
  accepted
  rejected
  not_received
}

enum PayrollExternalResultStatus {
  processing
  completed
  completed_with_issues
  partially_completed
  rejected
  failed
}

enum PayrollExternalProcessingStatus {
  processed
  pending
  rejected
  failed
}

enum PayrollExternalPayslipStatus {
  available
  not_yet_available
  unavailable
}

enum PayslipStatus {
  released
  InProgress @map("in-progress")
}

enum AccountingTransferStatus {
  preparing
  submitting
  submitted
  failed
}

enum AccountingAcknowledgementStatus {
  pending
  accepted
  rejected
  not_received
}

enum AccountingReadinessStatus {
  ready
  blocked
}

enum AuditActorType {
  user
  system
  integration
}

enum AuditOutcome {
  Successful
  Failed
  Blocked
}

// Identity and RBAC. Firebase Authentication remains the credential owner;
// users.firebase_uid is only the application identity bridge.
model ApplicationRole {
  id          String              @id @default(uuid()) @db.Uuid
  code        ApplicationRoleCode @unique
  label       String              @db.VarChar(120)
  description String              @db.Text
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           User[]
  rolePermissions RolePermission[]

  @@map("application_roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  label       String   @db.VarChar(160)
  description String   @db.Text
  category    String   @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId            String   @map("role_id") @db.Uuid
  permissionId      String   @map("permission_id") @db.Uuid
  version           Int      @default(1)
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  updatedBySnapshot Json?    @map("updated_by_snapshot")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  role          ApplicationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  updatedByUser User?           @relation("RolePermissionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  firebaseUid        String     @unique @map("firebase_uid") @db.VarChar(128)
  username           String     @unique @db.VarChar(80)
  displayName        String     @map("display_name") @db.VarChar(160)
  roleId             String     @map("role_id") @db.Uuid
  employeeId         String?    @map("employee_id") @db.Uuid
  status             UserStatus @default(active)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  role                         ApplicationRole                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee                     Employee?                        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  rolePermissionUpdates        RolePermission[]                 @relation("RolePermissionUpdatedBy")
  settingUpdates               SystemSetting[]                  @relation("SystemSettingUpdatedBy")
  attendanceTimeIn             AttendanceRecord[]               @relation("AttendanceTimeInOperator")
  attendanceTimeOut            AttendanceRecord[]               @relation("AttendanceTimeOutOperator")
  attendanceVerifications      AttendanceRecord[]               @relation("AttendanceHrVerifier")
  correctionsSubmitted         AttendanceCorrection[]           @relation("CorrectionSubmittedBy")
  correctionsReviewed          AttendanceCorrection[]           @relation("CorrectionReviewedBy")
  payrollBatchesCreated        PayrollBatch[]                   @relation("PayrollBatchCreatedBy")
  payrollBatchesSubmitted      PayrollBatch[]                   @relation("PayrollBatchSubmittedBy")
  payrollBatchesFrozen         PayrollBatch[]                   @relation("PayrollBatchFrozenBy")
  payrollHandoffsSubmitted     PayrollHandoff[]                 @relation("PayrollHandoffSubmittedBy")
  accountingTransfersSubmitted AccountingTransfer[]             @relation("AccountingTransferSubmittedBy")
  auditEvents                  AuditEvent[]                     @relation("AuditActor")
  hrpsImports                  HrpsImport[]                     @relation("HrpsImportInitiatedBy")
  bundyImports                 BundyImport[]                    @relation("BundyImportInitiatedBy")
  bundyRollbacks               BundyImport[]                    @relation("BundyImportRolledBackBy")
  unifiedAttendanceRuns        UnifiedAttendanceProcessingRun[] @relation("UnifiedAttendanceRunInitiatedBy")

  @@index([employeeId])
  @@map("users")
}

// HRPS reference data. employee_id is the institutional integration key, not
// the relational primary key, so values such as 001 retain their leading zero.
model Employee {
  id                String                   @id @default(uuid()) @db.Uuid
  employeeId        String                   @unique @map("employee_id") @db.VarChar(64)
  displayName       String                   @map("display_name") @db.VarChar(160)
  department        String                   @db.VarChar(160)
  position          String?                  @db.VarChar(160)
  employmentStatus  EmployeeEmploymentStatus @map("employment_status")
  sourceSystem      EmployeeSourceSystem     @default(HRPS) @map("source_system")
  dataSource        String?                  @map("data_source") @db.VarChar(80)
  sourceUpdatedAt   DateTime?                @map("source_updated_at") @db.Timestamptz(3)
  syncedAt          DateTime?                @map("synced_at") @db.Timestamptz(3)
  legacyFirestoreId String?                  @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                            User[]
  schedules                        EmployeeSchedule[]
  attendanceRecords                AttendanceRecord[]
  corrections                      AttendanceCorrection[]
  payrollBatchItems                PayrollBatchItem[]
  payrollResultItems               PayrollResultItem[]
  payslips                         PayrollPayslip[]
  bundyEvents                      BundyRawEvent[]
  unifiedAttendanceProcessingItems UnifiedAttendanceProcessingItem[]

  @@index([department])
  @@index([employmentStatus])
  @@map("employees")
}

model EmployeeSchedule {
  id                String               @id @default(uuid()) @db.Uuid
  employeeId        String               @map("employee_id") @db.Uuid
  scheduleId        String               @map("schedule_id") @db.VarChar(120)
  workStart         DateTime?            @map("work_start") @db.Time(0)
  workEnd           DateTime?            @map("work_end") @db.Time(0)
  breakStart        DateTime?            @map("break_start") @db.Time(0)
  breakEnd          DateTime?            @map("break_end") @db.Time(0)
  shiftLabel        String?              @map("shift_label") @db.VarChar(120)
  workDays          Json                 @map("work_days")
  restDays          Json                 @map("rest_days")
  workLocation      String?              @map("work_location") @db.VarChar(200)
  sourceSystem      EmployeeSourceSystem @default(HRPS) @map("source_system")
  dataSource        String?              @map("data_source") @db.VarChar(80)
  effectiveFrom     DateTime?            @map("effective_from") @db.Date
  effectiveTo       DateTime?            @map("effective_to") @db.Date
  legacyFirestoreId String?              @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@unique([employeeId, scheduleId])
  @@index([employeeId, effectiveFrom])
  @@map("employee_schedules")
}

// HRPS import history stores safe operational metadata only. Raw CSV content
// is intentionally not persisted; the preview is revalidated from the upload
// before any business write is accepted.
model HrpsImport {
  id                   String               @id @default(uuid()) @db.Uuid
  sourceSystem         EmployeeSourceSystem @default(HRPS) @map("source_system")
  filename             String               @db.VarChar(255)
  contentHash          String               @map("content_hash") @db.VarChar(64)
  initiatedByUserId    String?              @map("initiated_by_user_id") @db.Uuid
  initiatedBySnapshot  Json                 @map("initiated_by_snapshot")
  startedAt            DateTime             @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz(3)
  status               HrpsImportStatus
  totalRows            Int                  @map("total_rows")
  newCount             Int                  @map("new_count")
  updatedCount         Int                  @map("updated_count")
  unchangedCount       Int                  @map("unchanged_count")
  invalidCount         Int                  @map("invalid_count")
  duplicateCount       Int                  @map("duplicate_count")
  needsReviewCount     Int                  @map("needs_review_count")
  createdEmployees     Int                  @default(0) @map("created_employees")
  updatedEmployees     Int                  @default(0) @map("updated_employees")
  schedulesCreated     Int                  @default(0) @map("schedules_created")
  schedulesUpdated     Int                  @default(0) @map("schedules_updated")
  accountsProvisioned  Int                  @default(0) @map("accounts_provisioned")
  accountsPending      Int                  @default(0) @map("accounts_pending")
  accountsFailed       Int                  @default(0) @map("accounts_failed")
  errorSummary         String?              @map("error_summary") @db.Text
  rollbackStartedAt    DateTime?            @map("rollback_started_at") @db.Timestamptz(3)
  rolledBackAt         DateTime?            @map("rolled_back_at") @db.Timestamptz(3)
  rolledBackByUserId   String?              @map("rolled_back_by_user_id") @db.Uuid
  rolledBackBySnapshot Json?                @map("rolled_back_by_snapshot")
  rollbackErrorSummary String?              @map("rollback_error_summary") @db.Text
  rollbackSummary      Json?                @map("rollback_summary")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  initiatedBy User?           @relation("HrpsImportInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  rows        HrpsImportRow[]

  @@index([startedAt, id])
  @@index([status, startedAt])
  @@index([contentHash])
  @@map("hrps_imports")
}

// Each processed HRPS row keeps explicit ownership and minimal before/after
// snapshots so rollback never has to infer ownership from timestamps.
model HrpsImportRow {
  id                     String              @id @default(uuid()) @db.Uuid
  importId               String              @map("import_id") @db.Uuid
  rowNumber              Int                 @map("row_number")
  employeeId             String?             @map("employee_id") @db.VarChar(64)
  classification         String              @db.VarChar(40)
  employeeRecordId       String?             @map("employee_record_id") @db.Uuid
  employeeCreated        Boolean             @default(false) @map("employee_created")
  employeeBefore         Json?               @map("employee_before")
  employeeAfter          Json?               @map("employee_after")
  scheduleOwnership      Json                @default("{}") @map("schedule_ownership")
  applicationUserId      String?             @map("application_user_id") @db.Uuid
  applicationUserCreated Boolean             @default(false) @map("application_user_created")
  firebaseUid            String?             @map("firebase_uid") @db.VarChar(128)
  firebaseCreated        Boolean             @default(false) @map("firebase_created")
  rollbackStatus         HrpsImportRowStatus @default(PENDING) @map("rollback_status")
  rollbackMessage        String?             @map("rollback_message") @db.Text
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  import HrpsImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([employeeId])
  @@index([employeeRecordId])
  @@index([rollbackStatus])
  @@map("hrps_import_rows")
}

// Bundy imports retain safe operational metadata. Raw CSV content is never
// copied into PostgreSQL or audit metadata.
model BundyImport {
  id                   String            @id @default(uuid()) @db.Uuid
  filename             String            @db.VarChar(255)
  contentHash          String            @map("content_hash") @db.VarChar(64)
  initiatedByUserId    String?           @map("initiated_by_user_id") @db.Uuid
  initiatedBySnapshot  Json              @map("initiated_by_snapshot")
  startedAt            DateTime          @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(3)
  status               BundyImportStatus
  totalRows            Int               @map("total_rows")
  inCount              Int               @map("in_count")
  outCount             Int               @map("out_count")
  matchedCount         Int               @map("matched_count")
  unmatchedCount       Int               @map("unmatched_count")
  inactiveCount        Int               @map("inactive_count")
  duplicateScanCount   Int               @map("duplicate_scan_count")
  alreadyImportedCount Int               @map("already_imported_count")
  invalidCount         Int               @map("invalid_count")
  sourceConflictCount  Int               @map("source_conflict_count")
  importedCount        Int               @map("imported_count")
  devices              Json
  sourceBatches        Json              @map("source_batches")
  errorSummary         String?           @map("error_summary") @db.Text
  rollbackStartedAt    DateTime?         @map("rollback_started_at") @db.Timestamptz(3)
  rolledBackAt         DateTime?         @map("rolled_back_at") @db.Timestamptz(3)
  rolledBackByUserId   String?           @map("rolled_back_by_user_id") @db.Uuid
  rolledBackBySnapshot Json?             @map("rolled_back_by_snapshot")
  rollbackErrorSummary String?           @map("rollback_error_summary") @db.Text
  rollbackSummary      Json?             @map("rollback_summary")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  initiatedBy  User?           @relation("BundyImportInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  rolledBackBy User?           @relation("BundyImportRolledBackBy", fields: [rolledBackByUserId], references: [id], onDelete: SetNull)
  events       BundyRawEvent[]

  @@index([startedAt, id])
  @@index([status, startedAt])
  @@index([status, rollbackStartedAt])
  @@index([contentHash])
  @@map("bundy_imports")
}

// Bundy rows are immutable source evidence. Unified Attendance references them
// through AttendanceBundyEvidence without consuming or mutating raw rows.
model BundyRawEvent {
  id                          String                @id @default(uuid()) @db.Uuid
  importId                    String                @map("import_id") @db.Uuid
  sourceLogId                 String                @unique @map("source_log_id") @db.VarChar(160)
  deviceEmployeeId            String                @map("device_employee_id") @db.VarChar(64)
  employeeId                  String?               @map("employee_id") @db.Uuid
  sourceTimestamp             String                @map("source_timestamp") @db.VarChar(40)
  occurredAt                  DateTime              @map("occurred_at") @db.Timestamptz(3)
  event                       BundyEventType        @map("event")
  deviceId                    String                @map("device_id") @db.VarChar(120)
  sourceBatch                 String?               @map("source_batch") @db.VarChar(160)
  sourceProcessingStatus      String?               @map("source_processing_status") @db.VarChar(80)
  sourceMatchedHrpsEmployeeId String?               @map("source_matched_hrps_employee_id") @db.VarChar(64)
  matchStatus                 BundyMatchStatus      @map("match_status")
  validationStatus            BundyValidationStatus @map("validation_status")
  duplicateStatus             BundyDuplicateStatus  @map("duplicate_status")
  anomalyCodes                Json                  @default("[]") @map("anomaly_codes")
  importedAt                  DateTime              @default(now()) @map("imported_at") @db.Timestamptz(3)
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  import             BundyImport               @relation(fields: [importId], references: [id], onDelete: Restrict)
  employee           Employee?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  attendanceEvidence AttendanceBundyEvidence[]

  @@index([deviceEmployeeId, occurredAt])
  @@index([employeeId, occurredAt])
  @@index([matchStatus, occurredAt])
  @@index([duplicateStatus, occurredAt])
  @@index([importId, occurredAt])
  @@map("bundy_raw_events")
}

// AttendanceRecord is the existing canonical attendance model. Its legacy QR
// lifecycle status remains for compatibility while Unified Attendance adds
// separate technical and business state fields below.
model AttendanceRecord {
  id                      String                          @id @default(uuid()) @db.Uuid
  employeeId              String                          @map("employee_id") @db.Uuid
  attendanceDate          DateTime                        @map("attendance_date") @db.Date
  timeIn                  DateTime?                       @map("time_in") @db.Timestamptz(3)
  timeOut                 DateTime?                       @map("time_out") @db.Timestamptz(3)
  timeInSource            AttendanceSource?               @map("time_in_source")
  timeOutSource           AttendanceSource?               @map("time_out_source")
  timeInSourceReference   String?                         @map("time_in_source_reference") @db.VarChar(160)
  timeOutSourceReference  String?                         @map("time_out_source_reference") @db.VarChar(160)
  status                  AttendanceStatus
  timeInOperatorUserId    String?                         @map("time_in_operator_user_id") @db.Uuid
  timeOutOperatorUserId   String?                         @map("time_out_operator_user_id") @db.Uuid
  timeInActorSnapshot     Json?                           @map("time_in_actor_snapshot")
  timeOutActorSnapshot    Json?                           @map("time_out_actor_snapshot")
  hrVerificationStatus    HrVerificationStatus            @default(pending) @map("hr_verification_status")
  hrVerifiedAt            DateTime?                       @map("hr_verified_at") @db.Timestamptz(3)
  hrVerifiedByUserId      String?                         @map("hr_verified_by_user_id") @db.Uuid
  hrVerifiedBySnapshot    Json?                           @map("hr_verified_by_snapshot")
  payrollReadinessStatus  PayrollReadinessStatus          @default(blocked) @map("payroll_readiness_status")
  payrollReadinessReasons Json?                           @map("payroll_readiness_reasons")
  correctionMetadata      Json?                           @map("correction_metadata")
  sourceMetadata          Json?                           @map("source_metadata")
  legacyFirestoreId       String?                         @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  employeeScheduleId      String?                         @map("employee_schedule_id") @db.Uuid
  scheduleSnapshot        Json?                           @map("schedule_snapshot")
  technicalState          UnifiedAttendanceTechnicalState @default(IN_PROGRESS) @map("technical_state")
  businessStatus          UnifiedAttendanceBusinessStatus @default(UNCLASSIFIED) @map("business_status")
  processedAt             DateTime?                       @map("processed_at") @db.Timestamptz(3)
  processingVersion       String?                         @map("processing_version") @db.VarChar(80)
  lastReprocessedAt       DateTime?                       @map("last_reprocessed_at") @db.Timestamptz(3)
  requiresReview          Boolean                         @default(false) @map("requires_review")
  reviewReasonCode        String?                         @map("review_reason_code") @db.VarChar(80)

  employee                         Employee                          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  schedule                         EmployeeSchedule?                 @relation(fields: [employeeScheduleId], references: [id], onDelete: Restrict)
  timeInOperator                   User?                             @relation("AttendanceTimeInOperator", fields: [timeInOperatorUserId], references: [id], onDelete: SetNull)
  timeOutOperator                  User?                             @relation("AttendanceTimeOutOperator", fields: [timeOutOperatorUserId], references: [id], onDelete: SetNull)
  hrVerifiedBy                     User?                             @relation("AttendanceHrVerifier", fields: [hrVerifiedByUserId], references: [id], onDelete: SetNull)
  corrections                      AttendanceCorrection[]
  bundyEvidence                    AttendanceBundyEvidence[]
  unifiedAttendanceProcessingItems UnifiedAttendanceProcessingItem[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate, status])
  @@index([attendanceDate, timeInSource])
  @@index([hrVerificationStatus, payrollReadinessStatus, attendanceDate])
  @@index([technicalState, attendanceDate])
  @@index([businessStatus, attendanceDate])
  @@index([requiresReview, attendanceDate])
  @@index([employeeScheduleId])
  @@map("attendance_records")
}

// Bundy rows are immutable source evidence. Link rows may be replaced during
// controlled reprocessing, but the raw source rows themselves are preserved.
model AttendanceBundyEvidence {
  id                 String   @id @default(uuid()) @db.Uuid
  attendanceRecordId String   @map("attendance_record_id") @db.Uuid
  bundyRawEventId    String   @map("bundy_raw_event_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  bundyRawEvent    BundyRawEvent    @relation(fields: [bundyRawEventId], references: [id], onDelete: Restrict)

  @@unique([attendanceRecordId, bundyRawEventId])
  @@index([bundyRawEventId])
  @@map("attendance_bundy_evidence")
}

// A processing run records the bounded, auditable execution of the existing
// Unified Attendance employee/date processor. It never stores raw evidence.
model UnifiedAttendanceProcessingRun {
  id                  String                               @id @default(uuid()) @db.Uuid
  runType             UnifiedAttendanceProcessingRunType   @default(INITIAL) @map("run_type")
  dateFrom            DateTime                             @map("date_from") @db.Date
  dateTo              DateTime                             @map("date_to") @db.Date
  status              UnifiedAttendanceProcessingRunStatus
  initiatedByUserId   String?                              @map("initiated_by_user_id") @db.Uuid
  initiatedBySnapshot Json                                 @map("initiated_by_snapshot")
  startedAt           DateTime                             @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?                            @map("completed_at") @db.Timestamptz(3)
  totalItems          Int                                  @map("total_items")
  pendingItems        Int                                  @default(0) @map("pending_items")
  processingItems     Int                                  @default(0) @map("processing_items")
  completedItems      Int                                  @default(0) @map("completed_items")
  failedItems         Int                                  @default(0) @map("failed_items")
  createdCount        Int                                  @default(0) @map("created_count")
  updatedCount        Int                                  @default(0) @map("updated_count")
  unchangedCount      Int                                  @default(0) @map("unchanged_count")
  needsReviewCount    Int                                  @default(0) @map("needs_review_count")
  errorSummary        String?                              @map("error_summary") @db.Text
  createdAt           DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)

  initiatedBy User?                             @relation("UnifiedAttendanceRunInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  items       UnifiedAttendanceProcessingItem[]

  @@index([startedAt, id])
  @@index([status, startedAt])
  @@map("unified_attendance_processing_runs")
}

model UnifiedAttendanceProcessingItem {
  id                 String                                @id @default(uuid()) @db.Uuid
  runId              String                                @map("run_id") @db.Uuid
  employeeId         String                                @map("employee_id") @db.Uuid
  employeeReference  String                                @map("employee_reference") @db.VarChar(64)
  employeeName       String                                @map("employee_name") @db.VarChar(160)
  attendanceDate     DateTime                              @map("attendance_date") @db.Date
  attendanceRecordId String?                               @map("attendance_record_id") @db.Uuid
  status             UnifiedAttendanceProcessingItemStatus
  operation          UnifiedAttendanceProcessingOperation?
  technicalState     UnifiedAttendanceTechnicalState?      @map("technical_state")
  businessStatus     UnifiedAttendanceBusinessStatus?      @map("business_status")
  requiresReview     Boolean                               @default(false) @map("requires_review")
  attemptCount       Int                                   @default(0) @map("attempt_count")
  errorCode          String?                               @map("error_code") @db.VarChar(80)
  errorMessage       String?                               @map("error_message") @db.Text
  startedAt          DateTime?                             @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?                             @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  run              UnifiedAttendanceProcessingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee         Employee                       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
