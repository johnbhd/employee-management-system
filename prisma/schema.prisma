  submittedBy User?            @relation("CorrectionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User?            @relation("CorrectionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

