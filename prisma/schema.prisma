  employeeId          String                        @map("employee_id") @db.Uuid
  attendanceRecordId  String                        @map("attendance_record_id") @db.Uuid
  attendanceDate      DateTime                      @map("attendance_date") @db.Date
  issueType           AttendanceCorrectionIssueType @map("issue_type")
  status              AttendanceCorrectionStatus
  reason              String                        @db.Text
  originalSnapshot    Json?                         @map("original_snapshot")
  requestedChanges    Json                          @map("requested_changes")
  resultingSnapshot   Json?                         @map("resulting_snapshot")
  changedFields       Json                          @map("changed_fields")
  evidence            Json                          @default("[]")
  submittedByUserId   String?                       @map("submitted_by_user_id") @db.Uuid
  submittedBySnapshot Json                          @map("submitted_by_snapshot")
  reviewedByUserId    String?                       @map("reviewed_by_user_id") @db.Uuid
  reviewedBySnapshot  Json?                         @map("reviewed_by_snapshot")
  submittedAt         DateTime                      @map("submitted_at") @db.Timestamptz(3)
  reviewedAt          DateTime?                     @map("reviewed_at") @db.Timestamptz(3)
  reviewNote          String?                       @map("review_note") @db.Text
  legacyFirestoreId   String?                       @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
