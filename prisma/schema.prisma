// Payroll values are external outputs or immutable snapshots. This schema
// contains no local salary, tax, deduction, or net-pay calculation logic.
model PayrollBatch {
  id                  String             @id @default(uuid()) @db.Uuid
  batchReference      String             @unique @map("batch_reference") @db.VarChar(160)
  periodStart         DateTime           @map("period_start") @db.Date
  periodEnd           DateTime           @map("period_end") @db.Date
  periodLabel         String             @map("period_label") @db.VarChar(80)
  status              PayrollBatchStatus
  createdByUserId     String?            @map("created_by_user_id") @db.Uuid
  createdBySnapshot   Json               @map("created_by_snapshot")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedByUserId   String?            @map("submitted_by_user_id") @db.Uuid
  submittedBySnapshot Json?              @map("submitted_by_snapshot")
  submittedAt         DateTime?          @map("submitted_at") @db.Timestamptz(3)
  frozenByUserId      String?            @map("frozen_by_user_id") @db.Uuid
  frozenBySnapshot    Json?              @map("frozen_by_snapshot")
  frozenAt            DateTime?          @map("frozen_at") @db.Timestamptz(3)
  recordCount         Int                @map("record_count")
  blockedCount        Int                @map("blocked_count")
  notes               String?            @db.Text
  legacyFirestoreId   String?            @unique @map("legacy_firestore_id") @db.VarChar(160)

  createdBy           User?                @relation("PayrollBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submittedBy         User?                @relation("PayrollBatchSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  frozenBy            User?                @relation("PayrollBatchFrozenBy", fields: [frozenByUserId], references: [id], onDelete: SetNull)
  items               PayrollBatchItem[]
  handoff             PayrollHandoff?
  results             PayrollResult[]
  accountingTransfers AccountingTransfer[]

  @@index([updatedAt, id])
  @@index([periodStart, status])
  @@map("payroll_batches")
}

model PayrollBatchItem {
  id                     String                 @id @default(uuid()) @db.Uuid
  batchId                String                 @map("batch_id") @db.Uuid
  employeeId             String                 @map("employee_id") @db.Uuid
  employeePeriodId       String                 @map("employee_period_id") @db.VarChar(160)
  periodStart            DateTime               @map("period_start") @db.Date
  periodEnd              DateTime               @map("period_end") @db.Date
  employeeIdSnapshot     String                 @map("employee_id_snapshot") @db.VarChar(64)
  employeeNameSnapshot   String                 @map("employee_name_snapshot") @db.VarChar(160)
  departmentSnapshot     String                 @map("department_snapshot") @db.VarChar(160)
  presentDays            Int                    @map("present_days")
  lateCount              Int?                   @map("late_count")
  lateMinutes            Int?                   @map("late_minutes")
  undertimeMinutes       Int?                   @map("undertime_minutes")
  hrVerificationStatus   HrVerificationStatus   @default(verified) @map("hr_verification_status")
  payrollReadinessStatus PayrollReadinessStatus @default(ready) @map("payroll_readiness_status")
  sourceAttendanceIds    Json                   @map("source_attendance_ids")
  attendanceSnapshot     Json?                  @map("attendance_snapshot")
  scheduleSnapshot       Json?                  @map("schedule_snapshot")
  verificationSnapshot   Json?                  @map("verification_snapshot")
  snapshotCreatedAt      DateTime               @map("snapshot_created_at") @db.Timestamptz(3)
  legacyFirestoreId      String?                @unique @map("legacy_firestore_id") @db.VarChar(160)

  batch    PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, periodStart])
  @@unique([batchId, employeePeriodId])
  @@index([employeeId, periodStart])
  @@map("payroll_batch_items")
}

model PayrollHandoff {
  id                    String                       @id @default(uuid()) @db.Uuid
  batchId               String                       @unique @map("batch_id") @db.Uuid
  transferReference     String                       @unique @map("transfer_reference") @db.VarChar(160)
  periodStart           DateTime                     @map("period_start") @db.Date
  periodEnd             DateTime                     @map("period_end") @db.Date
  periodLabel           String                       @map("period_label") @db.VarChar(80)
  submittedByUserId     String?                      @map("submitted_by_user_id") @db.Uuid
  submittedBySnapshot   Json                         @map("submitted_by_snapshot")
  readyAt               DateTime                     @map("ready_at") @db.Timestamptz(3)
  submittedAt           DateTime                     @map("submitted_at") @db.Timestamptz(3)
  acknowledgedAt        DateTime?                    @map("acknowledged_at") @db.Timestamptz(3)
  failedAt              DateTime?                    @map("failed_at") @db.Timestamptz(3)
  transferStatus        PayrollTransferStatus        @map("transfer_status")
  acknowledgementStatus PayrollAcknowledgementStatus @map("acknowledgement_status")
  externalReference     String?                      @map("external_reference") @db.VarChar(200)
  provider              String                       @db.VarChar(120)
  failureCode           String?                      @map("failure_code") @db.VarChar(120)
  failureSummary        String?                      @map("failure_summary") @db.Text
  attemptCount          Int                          @default(0) @map("attempt_count")
  batchSummarySnapshot  Json                         @map("batch_summary_snapshot")
  legacyFirestoreId     String?                      @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch               PayrollBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  submittedBy         User?                @relation("PayrollHandoffSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  result              PayrollResult?
  accountingTransfers AccountingTransfer[]

  @@index([transferStatus, updatedAt])
  @@index([acknowledgementStatus, updatedAt])
  @@map("payroll_handoffs")
}

model PayrollResult {
  id                         String                      @id @default(uuid()) @db.Uuid
  batchId                    String                      @map("batch_id") @db.Uuid
  handoffId                  String                      @unique @map("handoff_id") @db.Uuid
  resultReference            String                      @unique @map("result_reference") @db.VarChar(160)
  externalPayrollReference   String                      @map("external_payroll_reference") @db.VarChar(200)
  status                     PayrollExternalResultStatus
  provider                   String                      @db.VarChar(120)
  employeeCount              Int                         @map("employee_count")
  processedCount             Int                         @map("processed_count")
  pendingCount               Int                         @map("pending_count")
  rejectedCount              Int                         @map("rejected_count")
  failedCount                Int                         @map("failed_count")
  payslipAvailableCount      Int                         @map("payslip_available_count")
  accountingReadinessStatus  AccountingReadinessStatus   @default(blocked) @map("accounting_readiness_status")
  accountingReadinessReasons Json?                       @map("accounting_readiness_reasons")
  receivedAt                 DateTime                    @map("received_at") @db.Timestamptz(3)
  processedAt                DateTime?                   @map("processed_at") @db.Timestamptz(3)
  completedAt                DateTime?                   @map("completed_at") @db.Timestamptz(3)
  legacyFirestoreId          String?                     @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch              PayrollBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  handoff            PayrollHandoff      @relation(fields: [handoffId], references: [id], onDelete: Restrict)
  items              PayrollResultItem[]
  accountingTransfer AccountingTransfer?

  @@index([batchId])
  @@index([status, updatedAt])
  @@index([accountingReadinessStatus, updatedAt])
  @@map("payroll_results")
}

model PayrollResultItem {
  id                        String                          @id @default(uuid()) @db.Uuid
  resultId                  String                          @map("result_id") @db.Uuid
  employeeId                String?                         @map("employee_id") @db.Uuid
  employeeIdSnapshot        String                          @map("employee_id_snapshot") @db.VarChar(64)
  employeeNameSnapshot      String                          @map("employee_name_snapshot") @db.VarChar(160)
  departmentSnapshot        String                          @map("department_snapshot") @db.VarChar(160)
  periodStart               DateTime                        @map("period_start") @db.Date
  periodEnd                 DateTime                        @map("period_end") @db.Date
  externalEmployeeReference String                          @map("external_employee_reference") @db.VarChar(200)
  externalPayrollReference  String?                         @map("external_payroll_reference") @db.VarChar(200)
  processingStatus          PayrollExternalProcessingStatus @map("processing_status")
  payslipStatus             PayrollExternalPayslipStatus    @map("payslip_status")
  externalPayslipId         String?                         @map("external_payslip_id") @db.VarChar(200)
  issueCode                 String?                         @map("issue_code") @db.VarChar(120)
  issueSummary              String?                         @map("issue_summary") @db.Text
  processedAt               DateTime?                       @map("processed_at") @db.Timestamptz(3)
  releasedAt                DateTime?                       @map("released_at") @db.Timestamptz(3)
  legacyFirestoreId         String?                         @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt                 DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)

  result   PayrollResult    @relation(fields: [resultId], references: [id], onDelete: Cascade)
  employee Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  payslips PayrollPayslip[]

  @@unique([resultId, employeeIdSnapshot])
  @@index([employeeId, periodEnd])
  @@index([processingStatus, payslipStatus])
  @@map("payroll_result_items")
}

model PayrollPayslip {
  id                 String        @id @default(uuid()) @db.Uuid
  employeeId         String        @map("employee_id") @db.Uuid
  resultItemId       String?       @map("result_item_id") @db.Uuid
  periodStart        DateTime      @map("period_start") @db.Date
  periodEnd          DateTime      @map("period_end") @db.Date
  payFrequency       String        @map("pay_frequency") @db.VarChar(80)
  monthlyBasicSalary Decimal?      @map("monthly_basic_salary") @db.Decimal(18, 2)
  cutoffBasicPay     Decimal?      @map("cutoff_basic_pay") @db.Decimal(18, 2)
  referenceDailyRate Decimal?      @map("reference_daily_rate") @db.Decimal(18, 2)
  basicPay           Decimal?      @map("basic_pay") @db.Decimal(18, 2)
  grossPay           Decimal?      @map("gross_pay") @db.Decimal(18, 2)
  deductions         Json
  totalDeductions    Decimal?      @map("total_deductions") @db.Decimal(18, 2)
  netPay             Decimal?      @map("net_pay") @db.Decimal(18, 2)
  status             PayslipStatus
  releasedAt         DateTime?     @map("released_at") @db.Timestamptz(3)
  source             String        @db.VarChar(80)
  payrollReference   String        @unique @map("payroll_reference") @db.VarChar(200)
  monthlySummary     Json          @map("monthly_summary")
  legacyFirestoreId  String?       @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  resultItem PayrollResultItem? @relation(fields: [resultItemId], references: [id], onDelete: SetNull)

  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId, periodEnd])
  @@index([status, releasedAt])
  @@map("payroll_payslips")
}

model AccountingTransfer {
  id                          String                          @id @default(uuid()) @db.Uuid
  payrollResultId             String                          @unique @map("payroll_result_id") @db.Uuid
  payrollBatchId              String                          @map("payroll_batch_id") @db.Uuid
  payrollHandoffId            String                          @map("payroll_handoff_id") @db.Uuid
  transferReference           String                          @unique @map("transfer_reference") @db.VarChar(160)
  periodStart                 DateTime                        @map("period_start") @db.Date
  periodEnd                   DateTime                        @map("period_end") @db.Date
  periodLabel                 String                          @map("period_label") @db.VarChar(80)
  externalPayrollReference    String                          @map("external_payroll_reference") @db.VarChar(200)
  employeeCount               Int                             @map("employee_count")
  payrollResultStatus         PayrollExternalResultStatus     @map("payroll_result_status")
  submittedByUserId           String?                         @map("submitted_by_user_id") @db.Uuid
  submittedBySnapshot         Json                            @map("submitted_by_snapshot")
  submittedAt                 DateTime                        @map("submitted_at") @db.Timestamptz(3)
  acknowledgedAt              DateTime?                       @map("acknowledged_at") @db.Timestamptz(3)
  failedAt                    DateTime?                       @map("failed_at") @db.Timestamptz(3)
  transferStatus              AccountingTransferStatus        @map("transfer_status")
  acknowledgementStatus       AccountingAcknowledgementStatus @map("acknowledgement_status")
  externalAccountingReference String?                         @map("external_accounting_reference") @db.VarChar(200)
  provider                    String                          @db.VarChar(120)
  failureCode                 String?                         @map("failure_code") @db.VarChar(120)
  failureSummary              String?                         @map("failure_summary") @db.Text
  attemptCount                Int                             @default(0) @map("attempt_count")
  legacyFirestoreId           String?                         @unique @map("legacy_firestore_id") @db.VarChar(160)
  createdAt                   DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)

  payrollResult  PayrollResult  @relation(fields: [payrollResultId], references: [id], onDelete: Restrict)
  payrollBatch   PayrollBatch   @relation(fields: [payrollBatchId], references: [id], onDelete: Restrict)
  payrollHandoff PayrollHandoff @relation(fields: [payrollHandoffId], references: [id], onDelete: Restrict)
  submittedBy    User?          @relation("AccountingTransferSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([transferStatus, updatedAt])
  @@index([acknowledgementStatus, updatedAt])
  @@map("accounting_transfers")
}

model AuditEvent {
  id               String         @id @default(uuid()) @db.Uuid
  eventType        String         @map("event_type") @db.VarChar(160)
  action           String         @db.VarChar(160)
  module           String         @db.VarChar(120)
  actorType        AuditActorType @map("actor_type")
  actorUserId      String?        @map("actor_user_id") @db.Uuid
  actorUid         String?        @map("actor_uid") @db.VarChar(128)
  actorSnapshot    Json           @map("actor_snapshot")
  targetType       String         @map("target_type") @db.VarChar(120)
  targetId         String?        @map("target_id") @db.VarChar(160)
  targetReference  String         @map("target_reference") @db.VarChar(200)
  targetLabel      String         @map("target_label") @db.VarChar(200)
  targetSnapshot   Json?          @map("target_snapshot")
  outcome          AuditOutcome
  summary          String         @db.Text
  metadata         Json           @default("{}")
  sourceCollection String?        @map("source_collection") @db.VarChar(120)
  legacyDocumentId String?        @map("legacy_document_id") @db.VarChar(160)
  occurredAt       DateTime       @map("occurred_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([sourceCollection, legacyDocumentId])
  @@index([occurredAt, id])
  @@index([module, occurredAt])
  @@index([actorUid, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}

// The registry of supported setting keys remains in application code. This
// row stores only validated runtime overrides and its optimistic version.
model SystemSetting {
  id                String   @id @default(uuid()) @db.Uuid
  settingKey        String   @unique @default("runtime") @map("setting_key") @db.VarChar(80)
  overrides         Json     @default("{}")
  version           Int      @default(0)
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  updatedBySnapshot Json?    @map("updated_by_snapshot")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedByUser User? @relation("SystemSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
